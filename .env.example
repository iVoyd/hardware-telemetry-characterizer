# Optional remote Linux DUT connection settings. Replace placeholders locally;
# never commit real hostnames, usernames, paths, or credentials.
HTC_DUT_HOST=example.invalid
HTC_DUT_USER=operator
HTC_DUT_DIR=/tmp/htc-deploy
HTC_DUT_PORT=22

# Optional path to a local SSH private key, if your SSH configuration needs one.
# HTC_DUT_SSH_KEY=/path/to/local/key
